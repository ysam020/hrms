{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Praesto",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.sw.json && vite build && vite build --ssr src/prerender/entry.tsx && node scripts/prerender.mjs && vite build -c vite.sw.config.ts && node scripts/inject-sw-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.0",
    "face-api.js": "^0.22.2",
    "firebase": "^11.0.1",
    "framer-motion": "^12.40.0",
    "idb": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "socket.io-client": "^4.8.1",
    "ua-parser-js": ">=2.0.10 <3.0.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "workbox-build": "^7.4.0"
  }
}
