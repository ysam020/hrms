{
  "name": "@hrms/proto",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "mkdir -p src/generated && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,env=node,useDate=false -I./src/proto $(find ./src/proto -name '*.proto')",
    "build": "pnpm generate && tsc -b"
  },
  "devDependencies": {
    "@hrms/typescript-config": "workspace:*",
    "ts-proto": "^2.11.6"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.12.3"
  }
}
