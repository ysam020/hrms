generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mongodb"
  url      = env("DEV_MONGODB_URI")
}

// relationMode defaults to "prisma" for the mongodb provider — referential
// actions (onDelete/onUpdate) below are emulated by the client, not the DB,
// and only ever operate within the single physical database a given
// PrismaClient instance is connected to (see packages/database/src/tenantClientPool.ts).
//
// Several models below declare a `user User? @relation(...)` field even
// though User always lives in the master DB (see MASTER_MODELS in
// prismaWithTenant.ts) while the model itself lives in a tenant DB. That
// relation is real for typing/documentation purposes, but Prisma's
// onDelete emulation can never reach across databases — deleting a User
// will not (and structurally cannot) cascade into tenant-DB collections.
// Those fields intentionally have no onDelete clause; cleaning up
// user-scoped tenant data on account deletion has to happen in application
// code, not the schema.

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  slug                   String    @unique
  dbName                 String?   @unique
  plan                   String    @default("pro")
  billing                String?
  industry               String?
  companySize            String?
  // Intentionally NOT @unique here for the same reason as `domain` below:
  // Prisma's MongoDB connector doesn't emit sparse:true for optional
  // @unique fields (prisma/prisma#12827), so a plain unique index throws
  // E11000 on the second tenant ever created with this left null (e.g. a
  // seed script). Uniqueness is instead enforced by a partial unique index
  // created directly against the driver — see ensureMasterIndexes() in
  // packages/database/src/ensureIndexes.ts, called once at gateway boot.
  // Prisma still maps the resulting duplicate-key error to P2002 on
  // tenant.create() even though the index isn't declared here.
  razorpaySubscriptionId String?
  // Set transiently during a payment-method swap (see confirmPaymentMethodChange
  // in payment.ts) to the subscription being retired; cleared once its
  // cancellation is confirmed. subscriptionReconciler.ts retries the cancel
  // on every run while this is still set, so a failed cancel never silently
  // leaves the old subscription (and its old mandate) billing forever.
  previousRazorpaySubscriptionId String?
  // active | grace_period | cancelled | expired | cancelling (legacy, no
  // longer set — see cancelSubscription in payment.ts). "cancelled" means the
  // user opted out; access continues until planExpiresAt (checked live by
  // requireActiveSubscription), distinct from "expired" (involuntary lapse).
  subscriptionStatus     String    @default("active")
  planActivatedAt        DateTime?
  planExpiresAt          DateTime?
  // "starter" (1-25 employees) | "growth" (26-100) | "enterprise" (101+) —
  // three flat-fee slabs, not per-employee billing. See
  // apps/api-gateway/src/config/billingPlans.ts for the actual prices.
  planTier               String    @default("starter")
  // Set when a downgrade or billing-period change is requested — Razorpay is
  // told to apply it at the end of the current cycle (schedule_change_at:
  // "cycle_end"), and the subscription.charged webhook (or, as a fallback,
  // subscriptionReconciler.ts) copies these onto planTier/billing and clears
  // them once that cycle actually renews. Never applied immediately/prorated —
  // only tier upgrades on an unchanged billing period are.
  pendingPlanTier        String?
  pendingBilling         String?
  // Mirrors planExpiresAt at the moment the change was scheduled — display-only,
  // Razorpay's own schedule (not this field) drives when the change lands.
  pendingPlanChangeAt    DateTime?
  // Quantity Razorpay last charged on a per_seat subscription — carried onto
  // the renewal invoice PDF (see invoice.ts) since the webhook only has the
  // charged amount, not the headcount that produced it.
  lastBilledQuantity     Int?
  paymentMethod          String?   // card | upi | netbanking | emandate | wallet
  paymentMethodSummary   String?   // e.g. "Visa •••• 1111" | "john@upi" | "HDFC Bank"
  helpPhone              String?
  helpEmail              String?
  officeAddress          String?
  // Tax Deduction and Collection Account Number — required on Form 16/Form
  // 24Q, printed on the annual Form 16 certificate (see form16.ts).
  tan                    String?
  website                String?
  // Work-location state, for Professional Tax slab lookup — set once during
  // org setup and applied to every employee's PT deduction (see
  // apps/api-gateway/src/handlers/payroll.ts), rather than captured per employee.
  workState              String?
  // Corporate Identification Number, and branding/signatory details used on
  // generated documents (e.g. the offer letter PDF — see offerLetter.ts).
  cin                    String?
  logoUrl                String?
  signatoryName          String?
  signatoryDesignation   String?
  // Company email domain, used to suggest joining an existing org instead of
  // creating a duplicate. Intentionally NOT @unique: Prisma does not emit
  // sparse:true for optional @unique fields on MongoDB (prisma/prisma#12827),
  // so a plain unique index throws E11000 on the second tenant ever created
  // with domain left null (e.g. a free-mail signup). "One tenant per domain"
  // is enforced in application code (buildTenant) instead — see tenant.ts.
  domain                 String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())

  @@index([domain])
  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  userId    String   @db.ObjectId
  // "owner" | "admin" | "hr" | "manager" | "employee"
  role      String
  invitedBy String?  @db.ObjectId
  joinedAt  DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model TenantJoinRequest {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String    @db.ObjectId
  userId          String    @db.ObjectId
  email           String // canonicalized email at request time, for admin display/audit
  domain          String // matched domain at request time, for audit
  // "pending" | "approved" | "rejected"
  status          String    @default("pending")
  reviewedBy      String?   @db.ObjectId
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_join_requests")
}

// RazorpayX payout webhooks arrive with no auth/session context, but
// PayrollLineItem (like all business models) lives in the tenant's own
// physical DB — the webhook has no way to know which tenant DB to query
// without this. Written once at payout-creation time (see payroll.ts
// disburse flow), read once by the webhook to resolve tenant context
// before touching any tenant-scoped model.
model PayoutTenantIndex {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  payoutId String @unique
  tenantId String @db.ObjectId

  @@map("payout_tenant_index")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                    String?   @db.ObjectId
  username                    String    @unique
  password                    String?
  email                       String?   @unique
  official_email              String?
  // The candidate's original application email (JobApplication.email),
  // copied over when HR links a hired candidate to this account during
  // join-request approval — see approveJoinRequest in handlers/tenant.ts.
  // `email` itself is the login identity (the company/OAuth email), so this
  // is the only place the pre-hire personal email is preserved on the
  // employee record directly.
  personalEmail               String?
  first_name                  String?
  middle_name                 String?
  last_name                   String?
  mobile                      String?
  dob                         DateTime?
  blood_group                 String?
  qualification               String?
  role                        String[]
  permissions                 String[]
  isSuperUser                 Boolean   @default(false)
  wfh                         Boolean   @default(false)
  // WFH home location (set by admin when enabling WFH for this employee)
  wfhHomeLatitude             Float?
  wfhHomeLongitude            Float?
  wfhHomeName                 String?   // human-readable address label
  note                        String?
  employeeStatus              String    @default("Active")
  reasonForTermination        String?
  dateOfTermination           DateTime?
  dateOfAbscond               DateTime?
  designation                 String?
  department                  String?
  // Optional FKs alongside the free-text strings above — kept free-text as
  // the source of truth so onboarding/employee-add never blocks on Org
  // Structure being configured. UI/reports prefer the resolved relation name
  // when set, else fall back to the string. See POST /org-structure/migrate-from-free-text.
  departmentId                 String?   @db.ObjectId
  designationId                String?   @db.ObjectId
  // office (default, geofenced) | field | remote — field/remote skip geofencing entirely.
  attendanceMode              String    @default("office")
  payCycleId                    String?   @db.ObjectId
  joining_date                DateTime?
  employee_photo              String?
  face_descriptor             Json?
  // Address
  permanent_address_line_1    String?
  permanent_address_line_2    String?
  permanent_address_city      String?
  permanent_address_state     String?
  permanent_address_pincode   String?
  communication_address_line_1  String?
  communication_address_line_2  String?
  communication_address_city    String?
  communication_address_state   String?
  communication_address_pincode String?
  // KYC documents
  aadhar_no                   String?
  aadhar_photo_front          String?
  aadhar_photo_back           String?
  pan_no                      String?
  pan_photo                   String?
  education_certificates      String[]
  experience_certificate      String?
  electricity_bill            String?
  pf_no                       String?
  uan_no                      String?
  esic_no                     String?
  bank_account_no             String?
  bank_name                   String?
  ifsc_code                   String?
  kyc_date                    DateTime?
  // Pending | Approved | Revision Requested | Edit Requested
  kyc_approval                String?
  // {field_name: issue description} — set when kyc_approval == "Revision
  // Requested"; cleared when HR approves again (a resubmission alone does
  // not clear it, so HR always sees what they originally flagged).
  kyc_revision_notes          Json?
  // Employee's own stated reason for wanting to edit an already-approved
  // KYC (e.g. "bank account changed"); set when kyc_approval == "Edit
  // Requested", cleared once HR allows editing (-> back to Pending) so it
  // never lingers into an unrelated future request.
  kyc_edit_request_reason     String?
  kyc_edit_requested_at       DateTime?
  // "open" | "closed" | null. allowKycEdit sets "open" — the one edit that
  // reopen grants is allowed. submitKyc's self-submit path flips "open" to
  // "closed" the moment that edit lands, re-locking the record (still
  // kyc_approval "Pending") until HR reviews it again; any other
  // self-submit (fresh onboarding, a Revision Requested resubmission)
  // recomputes this to null, so the lock never outlives the reopen it
  // belongs to. See allowKycEdit.ts / submitKyc.ts.
  kyc_edit_window             String?
  reference_by                String?
  // Auth
  refreshToken                String?
  // AES-encrypted (see @hrms/crypto's aesEncrypt/aesDecrypt, same pattern as
  // other sensitive fields) offline refresh token from the "Connect Google
  // Calendar" consent flow (distinct from the login OAuth flow — see
  // apps/api-gateway/src/services/googleCalendar.ts) — lets recruitment
  // create real Calendar events with a Google Meet link on this user's own
  // calendar when they schedule an interview. Per-user by design: each
  // connected user's events are created on their own calendar, never a
  // shared/tenant-level identity.
  googleCalendarRefreshToken  String?
  webAuthnCredentials         Json?
  fcmTokens                   Json?
  events                      Json?
  createdAt                   DateTime? @default(now())
  updatedAt                   DateTime? @updatedAt

  attendanceRecords           AttendanceRecord[]
  leaveApplications           LeaveApplication[]
  notifications               NotificationRecipient[]
  salaryStructures            SalaryStructure[]
  loginEvents                 LoginEvent[]
  performanceReviews          PerformanceReview[]


  @@index([employeeStatus])
  @@index([department, employeeStatus])
  // User is the one master-DB model shared across every tenant (see
  // masterScopedPrisma in prismaWithTenant.ts, which auto-injects tenantId
  // into every query) — unlike per-tenant-DB models, tenantId here is a
  // real, high-cardinality filter on nearly every query, not a redundant
  // safety net.
  @@index([tenantId, employeeStatus])
  @@map("users")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String?  @db.ObjectId
  userId       String   @db.ObjectId
  date         DateTime
  timeIn       DateTime?
  timeOut      DateTime?
  workingHours Float?
  // Hours beyond TenantSettings.fullDayMinHours — see resolveOvertimeHours.
  // Only non-zero when overtimePreApprovalRequired is off, or an approved
  // OvertimeRequest exists for this user+date.
  overtimeHours Float?
  status       String?
  isCorrected  Boolean  @default(false)
  correctedBy  String?  @db.ObjectId

  user         User?    @relation(fields: [userId], references: [id])
  breaks       AttendanceBreak[]

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@map("attendance_records")
}

// Sub-punches within a single AttendanceRecord day — the unique-per-day
// constraint above stays as the one canonical timeIn/timeOut; breaks are
// nested inside that day rather than requiring a full multi-punch redesign.
model AttendanceBreak {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String    @db.ObjectId
  attendanceRecordId String    @db.ObjectId
  breakType          String    @default("lunch") // lunch | short_break | other
  isPaid             Boolean   @default(false)
  startTime          DateTime
  endTime            DateTime?
  durationMinutes    Float?

  record             AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
  @@map("attendance_breaks")
}

model OvertimeRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String    @db.ObjectId
  userId       String    @db.ObjectId
  date         DateTime
  plannedHours Float
  reason       String?
  status       String    @default("Pending") // Pending | Approved | Rejected
  approvedBy   String?   @db.ObjectId
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, status])
  @@map("overtime_requests")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveApplication {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String?  @db.ObjectId
  userId            String   @db.ObjectId
  from              DateTime
  to                DateTime
  leaveType         String
  days              Float
  status            String   @default("Pending")
  reason            String?
  sickLeave         Boolean?
  medicalCertificate String?
  appliedOn         DateTime?
  approvedById      String?  @db.ObjectId
  approvedOn        DateTime?

  // Application unit — "full_day" is the legacy default. session is required
  // when unit=half_day; shortLeaveHours is required when unit=short_leave.
  unit               String    @default("full_day") // full_day | half_day | short_leave
  session            String?   // first_half | second_half
  shortLeaveHours    Float?

  // Cancellation-after-approval: status transitions to "Cancellation Requested"
  // then "Cancelled" once approved, at which point `days` is credited back to
  // LeaveBalance. See packages/approval-engine module "leave", condition
  // isCancellation.
  cancelledOn        DateTime?
  cancelledBy        String?   @db.ObjectId
  cancellationReason String?

  user              User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("leaves")
}

// Comp-off earned by working a holiday/weekend — a transactional fact tied to
// a specific worked date, distinct from the policy-level config in
// TenantSettings.leavePolicies (which just flags a leave type as isCompOff
// and sets its default expiry window).
model CompOffCredit {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                 String    @db.ObjectId
  userId                   String    @db.ObjectId
  sourceDate               DateTime  // the worked holiday/weekend that earned it
  earnedDays               Float     @default(1)
  expiresOn                DateTime?
  status                   String    @default("available") // available | used | expired
  usedInLeaveApplicationId String?   @db.ObjectId
  createdBy                String    @db.ObjectId
  createdAt                DateTime  @default(now())

  @@index([tenantId, userId, status])
  @@map("comp_off_credits")
}

model LeaveBalance {
  id                              String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                        String?  @db.ObjectId
  userId                          String   @db.ObjectId
  accumulatedPLBeforeCurrentMonth Float    @default(0)
  balances                        Json?
  createdAt                       DateTime? @default(now())
  updatedAt                       DateTime? @updatedAt

  @@unique([tenantId, userId])
  @@map("leavebalances")
}

// ─── Job Openings & Applications ─────────────────────────────────────────────

model JobOpening {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String?   @db.ObjectId
  jobTitle           String
  numberOfVacancies  Int?
  jobPostingDate     DateTime? @default(now())
  applicationDeadline DateTime
  jobDescription     String
  requiredSkills     String
  experience         Float
  budget             Float[]
  department         String?
  hiringManager      String
  candidatesHired    Int       @default(0)
  status             String
  createdBy          String
  createdOn          DateTime? @default(now())
  lastUpdateBy       String?
  lastUpdatedOn      DateTime?
  deletedBy          String?
  deletedOn          DateTime?

  applications       JobApplication[]

  // null = tenant default template. internal/external visibility gate.
  pipelineTemplateId String?   @db.ObjectId
  visibility         String    @default("external") // internal | external | both

  @@index([status, createdOn])
  @@map("jobopenings")
}

model JobApplication {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String?  @db.ObjectId
  name         String?
  mobile       String?
  email        String?
  aadharNo     String?
  jobTitleId   String?  @db.ObjectId
  resume       String?
  // Legacy unstructured pipeline storage — left untouched for existing rows.
  // New code writes ApplicationStageEvent instead (see below).
  interviews   Json?
  reason       String?
  status       String   @default("Applied")
  resumeScore  Float?
  aiNotes      String?
  // Set when status transitions to Rejected/Hired etc. via updateApplicationStatus.
  remarks         String?
  hireSalary      Float?
  hireJoiningDate DateTime?
  hireReferredBy  String?
  // Full component breakdown captured at hire time (same shape as
  // SalaryStructure.componentBreakdown) — hireSalary stays as the derived
  // monthly gross (sum of earning components) for display/back-compat.
  // Null for candidates hired before this field existed; consumers must
  // fall back to the old deriveOfferCompensationBreakup(hireSalary) path.
  hireSalaryComponents Json?
  // The company email HR/IT is provisioning for this hire, recorded before
  // the candidate's first login — lets join-request approval match by exact
  // email instead of guessing by name similarity. See updateAssignedOfficialEmail
  // / listHiredCandidateMatches in handlers/{recruitment,tenant}.ts.
  assignedOfficialEmail String?

  // Set when an existing employee applies internally, rather than being
  // re-entered as an external candidate.
  userId             String?  @db.ObjectId
  // Snapshot of the template used at apply-time, in case it's edited later.
  pipelineTemplateId String?  @db.ObjectId
  currentStageOrder  Int      @default(0)
  referredByUserId   String?  @db.ObjectId

  jobOpening   JobOpening? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  stageEvents  ApplicationStageEvent[]
  offers       Offer[]

  @@index([jobTitleId])
  @@index([status])
  @@map("jobapplications")
}

// Reusable, tenant-configurable interview pipeline — replaces the implicit,
// ad-hoc round structure previously stored inline in JobApplication.interviews.
model InterviewPipelineTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  name      String   // "Engineering - Standard", "Sales Pipeline"
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  // [{ order, name, interviewerRole, outcomeOptions: ["pass","fail","hold"],
  //    isBgvStage, bgvVendor? }]
  stages    Json
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
  @@map("interview_pipeline_templates")
}

// Append-only stage-by-stage audit trail for one application moving through
// its pipeline — who interviewed, what the outcome was, panel scorecards.
model ApplicationStageEvent {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  applicationId String    @db.ObjectId
  stageName     String
  stageOrder    Int
  outcome       String?   // pass | fail | hold | pending
  interviewerId String?   @db.ObjectId
  scorecards    Json?     // panel: [{ interviewerId, score, notes }]
  bgvVendor     String?
  bgvResult     String?   // clear | flagged | pending
  scheduledAt   DateTime?
  completedAt   DateTime?
  notes         String?
  createdBy     String    @db.ObjectId
  createdAt     DateTime  @default(now())

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, stageOrder])
  @@index([tenantId, applicationId])
  @@map("application_stage_events")
}

// Versioned offer — an offer, a counter, and a revised offer each get their
// own row rather than overwriting a single "offer" field.
model Offer {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  applicationId String    @db.ObjectId
  version       Int       @default(1)
  designation   String?
  department    String?
  offeredCTC    Float?
  joiningDate   DateTime?
  status        String    @default("Draft") // Draft|Sent|Negotiating|Accepted|Declined|Withdrawn|Expired
  sentAt        DateTime?
  respondedAt   DateTime?
  candidateNote String?
  internalNote  String?
  createdBy     String    @db.ObjectId
  createdAt     DateTime  @default(now())

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, version])
  @@index([tenantId, status])
  @@map("offers")
}

// ─── Resignation ─────────────────────────────────────────────────────────────

model Resignation {
  id                          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                    String?   @db.ObjectId
  userId                      String?   @db.ObjectId
  resignationDate             DateTime?
  lastWorkingDay              DateTime?
  reason                      String?
  comments                    String?
  rejectionReason             String?
  overallJobSatisfaction      Float     @default(0)
  qualityOfCommunication      String?
  supportFromManager          String?
  appreciationForWork         String?
  collaborationWithinTheTeam  String?
  overallCompanyCulture       String?
  suggestions                 String?
  assetsReturned              Boolean?
  fnfDone                     Boolean?
  status                      String    @default("Submitted")
  submittedOn                 DateTime?
  approvedOn                  DateTime?
  rejectedOn                  DateTime?
  withdrawnOn                 DateTime?
  feedbackSubmittedOn         DateTime?
  lastUpdatedOn               DateTime?

  // voluntary | termination | absconding | mutual — branches the workflow
  // (absconding skips notice-period logic entirely; termination may skip the
  // employee-initiated steps).
  exitType             String    @default("voluntary")
  // Resolved from NoticePeriodPolicy at submission time. Kept alongside the
  // tenant-wide TenantSettings.noticePeriodDays flat fallback for tenants that
  // never configure tenure-based bands.
  noticePeriodDays     Int?
  noticePeriodWaived   Boolean   @default(false)
  buyoutAmount         Float?
  // Garden leave — relieved from active duty immediately, distinct from
  // lastWorkingDay (which payroll still runs through).
  relievedFromDutyOn   DateTime?
  rehireEligible       Boolean?

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("resignations")
}

// Tenure/role/department-based notice period bands. No rows for a tenant =
// zero-config default: the flat TenantSettings.noticePeriodDays value applies
// to everyone, exactly as today.
model NoticePeriodPolicy {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String   @db.ObjectId
  minTenureMonths   Int      @default(0)
  maxTenureMonths   Int?     // null = no upper bound
  designation       String?  // null = applies to all
  department        String?
  noticePeriodDays  Int
  // Applies while the employee is still within TenantSettings.probationPeriodDays,
  // taking priority over tenure-based bands.
  isProbationPolicy Boolean  @default(false)
  priority          Int      @default(0)
  createdBy         String   @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("notice_period_policies")
}

// Audit trail for lastWorkingDay renegotiation (e.g. employee asks to leave
// earlier, then manager asks them to stay two more weeks) — lastWorkingDay
// itself only ever holds the current value.
model ResignationNoticeEvent {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String   @db.ObjectId
  resignationId          String   @db.ObjectId
  previousLastWorkingDay DateTime?
  newLastWorkingDay      DateTime
  reason                 String?
  changedBy              String   @db.ObjectId
  createdAt              DateTime @default(now())

  @@index([resignationId])
  @@map("resignation_notice_events")
}

// Configurable exit-interview question set, replacing the hardcoded
// qualityOfCommunication/supportFromManager/... columns above (which stay,
// unused by new tenants, for backward compatibility with existing responses).
model ExitInterviewTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  isActive  Boolean  @default(true)
  questions Json     // [{ id, label, type: "rating"|"text"|"boolean", required }]
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exit_interview_templates")
}

model ExitInterviewResponse {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String   @db.ObjectId
  resignationId String   @db.ObjectId @unique
  templateId    String   @db.ObjectId
  answers       Json     // [{ questionId, value }]
  submittedOn   DateTime @default(now())

  @@map("exit_interview_responses")
}

// Configurable multi-department exit clearance checklist, replacing the
// assetsReturned/fnfDone booleans above (which stay as a quick top-level
// summary for tenants that never configure a custom checklist).
model ExitChecklistItemDef {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @db.ObjectId
  label      String   // "Return laptop", "Clear IT access"
  owningRole String   // "IT" | "Finance" | "HR" | "Admin"
  isRequired Boolean  @default(true)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([tenantId, isActive])
  @@map("exit_checklist_item_defs")
}

model ExitChecklistItemStatus {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  resignationId String    @db.ObjectId
  itemDefId     String    @db.ObjectId
  isComplete    Boolean   @default(false)
  completedBy   String?   @db.ObjectId
  completedAt   DateTime?
  notes         String?

  @@unique([resignationId, itemDefId])
  @@index([resignationId])
  @@map("exit_checklist_item_statuses")
}

model FnfSettlement {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                 String    @db.ObjectId
  resignationId            String    @db.ObjectId @unique
  userId                   String    @db.ObjectId
  lineItems                Json      // [{ label, type: "earning"|"deduction", amount }]
  leaveEncashmentAmount    Float     @default(0)
  noticeShortfallDeduction Float     @default(0)
  grossPayable             Float
  totalDeductions          Float
  netPayable               Float
  status                   String    @default("draft") // draft | approved | disbursed
  approvedBy               String?   @db.ObjectId
  approvedAt               DateTime?
  disbursedAt              DateTime?
  createdBy                String    @db.ObjectId
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("fnf_settlements")
}

// ─── Salary ───────────────────────────────────────────────────────────────────

model SalaryStructure {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String?  @db.ObjectId
  userId          String   @db.ObjectId
  grossSalary     Float
  month           Int
  year            Int
  basicPay        Float?
  hra             Float?
  conveyance      Float?
  incentive       Float?
  pf              Float?
  esi             Float?
  pt              Float?
  deductions      Float?
  // SalaryAdvance EMI deducted this month, if any — broken out of
  // `deductions` so payslips can itemize it instead of folding it into a
  // generic total (mirrors PayrollLineItem.advanceDeduction).
  advanceDeduction Float?
  // Income tax (TDS) withheld this month — see IncomeTaxSlab/TaxDeclaration
  // and calcMonthlyTds() in apps/api-gateway/src/utils/tdsCalc.ts.
  tds             Float?
  grossEarnings   Float?
  netPayable      Float?
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt

  // [{code, name, type: "earning"|"deduction", amount}] — when set, supersedes
  // the fixed basicPay/hra/... columns above for tenants that have configured
  // SalaryComponentDefinition rows. Those columns stay as the legacy 7-component
  // fallback when this is null.
  componentBreakdown Json?

  user            User?    @relation(fields: [userId], references: [id])

  // Was a plain @@index — payslip de-duplication (see updatePayrollRunStatus's
  // disburse branch in payroll.ts) relied on a manual findFirst-then-create/
  // update guard with no atomicity, so concurrent execution touching the
  // same (tenant, user, month, year) — e.g. a crash-and-rerun of
  // disbursement — could create duplicate payslip rows. A real @@unique
  // lets that guard become a single atomic upsert instead.
  @@unique([tenantId, userId, year, month])
  @@map("salarystructures")
}

// Tenant-configurable salary component (replaces/extends the fixed
// basic/hra/conveyance/incentive/pf/esi/pt column set). No rows for a tenant
// = every payroll run keeps using the 7 fixed columns, exactly as today.
model SalaryComponentDefinition {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  name         String
  code         String   // "BASIC","HRA","SPECIAL_ALLOWANCE","SHIFT_ALLOWANCE"
  type         String   // earning | deduction
  isTaxable    Boolean  @default(true)
  calcType     String   @default("fixed") // fixed | percent_of_basic | formula
  percentOf    String?
  percentValue Float?
  isStatutory  Boolean  @default(false) // PF/ESI/PT — cannot be deleted, only toggled
  // false = a one-time earning (e.g. a bonus/incentive) that shouldn't be
  // projected into future months on the TDS worksheet — see computeTdsWorksheet.
  isRecurring  Boolean  @default(true)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdBy    String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("salary_component_definitions")
}

// State-wise Professional Tax slabs — pt on SalaryStructure/PayrollLineItem
// stays a manually-entered flat value until a tenant configures slabs here.
model ProfessionalTaxSlab {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String   @db.ObjectId
  state         String
  minGross      Float
  maxGross      Float?
  monthlyPT     Float
  effectiveFrom DateTime @default(now())

  @@index([tenantId, state])
  @@map("professional_tax_slabs")
}

// Slab-based Income Tax (TDS, Section 192) rates — one row per income bracket
// per regime per financial year. Falls back to a hardcoded FY2025-26 table
// (NEW_REGIME_SLAB_FALLBACK / OLD_REGIME_SLAB_FALLBACK in tdsCalc.ts) exactly
// like ProfessionalTaxSlab does, until a tenant configures its own rows —
// slabs change almost every Union Budget so this can't be hardcoded forever.
model IncomeTaxSlab {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String   @db.ObjectId
  financialYear String   // e.g. "2025-26"
  regime        String   // "old" | "new"
  minIncome     Float
  maxIncome     Float?
  ratePercent   Float

  @@index([tenantId, financialYear, regime])
  @@map("income_tax_slabs")
}

// One row per employee per financial year — only created once an employee
// opts out of the default New Regime. A row's existence past "Draft" for the
// current financial year *is* the "this employee is on Old Regime" signal;
// no separate regime flag on User. Mirrors the KYC declare→lock→revision
// cycle (apps/api-gateway/src/handlers/employee.ts), extended with a second
// declare-then-prove stage: employees provisionally declare exemptions early
// in the year, then submit proofs later for HR to verify.
model TaxDeclaration {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  userId        String    @db.ObjectId
  financialYear String    // e.g. "2025-26"

  // HRA exemption inputs — the exemption itself is computed (see
  // calcHraExemption in tdsCalc.ts), not directly declared.
  monthlyRent   Float?
  isMetroCity   Boolean?

  // [{code, label, declaredAmount, proofAmount}] — codes: SEC80C,
  // SEC80D_SELF, SEC80D_PARENTS, HOME_LOAN_INTEREST, NPS_80CCD1B, OTHER.
  // A flat Json array (mirrors SalaryStructure.componentBreakdown) instead
  // of one column per section, so a new declarable section is a data
  // change, not a migration.
  lineItems     Json?

  // Draft | Submitted | RevisionRequested | Declared | ProofsSubmitted |
  // ProofRevisionRequested | Verified
  status        String    @default("Draft")
  revisionNotes Json?     // {field: issue}, same shape as User.kyc_revision_notes

  submittedAt   DateTime?
  declaredAt    DateTime?
  provenAt      DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?   @db.ObjectId

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, userId, financialYear])
  @@index([tenantId, status])
  @@map("tax_declarations")
}

// Multiple pay cycles within one tenant (e.g. bi-weekly factory floor vs
// monthly office staff). PayrollRun.payCycleId is an optional tag, not a
// uniqueness key — see PayrollRun comment.
model PayCycle {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  name      String
  frequency String   @default("monthly") // monthly | biweekly | weekly
  payDay    Int
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, isActive])
  @@map("pay_cycles")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String                  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String?                 @db.ObjectId
  title      String?
  message    String?
  timeStamp  DateTime? @default(now())
  eventType  String                  @default("general")
  activityId String?                 @db.ObjectId
  priority   String                  @default("medium")
  // BullMQ job id — set only for notifications created by
  // notificationWorker.ts, used to make a stalled/retried job a no-op
  // instead of creating (and re-broadcasting/re-pushing) a duplicate.
  // Intentionally NOT @unique: Prisma does not emit sparse:true for optional
  // @unique fields on MongoDB (prisma/prisma#12827) — see Tenant.domain
  // above for the same caveat. Idempotency is enforced in application code
  // (a findFirst-before-create guard in notificationWorker.ts) instead.
  jobId      String?

  recipients NotificationRecipient[]

  @@index([tenantId])
  @@index([jobId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String?      @db.ObjectId
  notificationId String       @db.ObjectId
  userId         String       @db.ObjectId
  isCleared      Boolean      @default(false)

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, isCleared])
  @@map("notification_recipients")
}

// ─── Roles ────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?  @db.ObjectId
  name        String?
  permissions String[]
  assignedTo  Json?

  @@index([tenantId])
  @@map("roles")
}

// ─── HR Activities ────────────────────────────────────────────────────────────

model HrActivity {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String?   @db.ObjectId
  title         String
  description   String
  scheduledAt   DateTime
  status        String
  createdBy     String
  createdOn     DateTime? @default(now())
  lastUpdatedOn DateTime? @default(now())
  lastUpdatedBy String?
  deletedBy     String?
  deletedOn     DateTime?

  @@map("hractivities")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatRoom {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String?   @db.ObjectId
  participants  String[]  @db.ObjectId
  type          String    @default("direct")
  name          String?
  lastMessageId String?   @db.ObjectId
  lastActivity  DateTime? @default(now())
  deletedFor    String[]  @db.ObjectId
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt

  messages      Message[]

  @@index([tenantId, participants])
  @@map("chatrooms")
}

model Message {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String?   @db.ObjectId
  chatRoomId   String    @db.ObjectId
  senderId     String    @db.ObjectId
  content      String?
  type         String    @default("text")
  fileUrl      String?
  fileName     String?
  fileMimeType String?
  fileSize     Float?
  replyToId    String?   @db.ObjectId
  readBy       String[]  @db.ObjectId
  isDeleted    Boolean   @default(false)
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?
  pinnedBy     String?   @db.ObjectId
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  chatRoom     ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@index([chatRoomId, isDeleted])
  @@index([chatRoomId, isPinned])
  @@map("messages")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?  @db.ObjectId
  userId      String?  @db.ObjectId
  // Denormalized at write time — survives the acting user later being
  // deleted/renamed, and avoids a join every time the log is displayed.
  username    String?
  action      String
  entityType  String
  oldValue    Json?
  newValue    Json?
  description String   @default("")
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime? @default(now())

  @@index([tenantId, timestamp])
  @@index([tenantId, userId, timestamp])
  @@index([tenantId, entityType, timestamp])
  @@map("auditlogs")
}

// ─── Holidays ─────────────────────────────────────────────────────────────────

model Holiday {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String?  @db.ObjectId
  year     Int
  month    Int
  holidays Json?

  @@unique([tenantId, year, month])
  @@map("holidays")
}

// ─── Policies ─────────────────────────────────────────────────────────────────

model Policy {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String?   @db.ObjectId
  policyType    String
  policyName    String?
  content       String
  status        String    @default("Active")
  createdBy     String
  createdOn     DateTime? @default(now())
  lastUpdatedOn DateTime? @default(now())
  lastUpdatedBy String?
  deletedBy     String?
  deletedOn     DateTime?

  @@map("policies")
}

// ─── Business Rules ───────────────────────────────────────────────────────────

// ─── Approval Chains ────────────────────────────────────────────────────────
// Generic, reusable multi-level approval routing consumed by Leave, Resignation,
// and (future) WFH/SalaryAdvance/Overtime. See packages/approval-engine.
// No ApprovalChain rows for a module = zero-config default: a single step
// resolved as the requester's reporting manager (Team.teamLeaderId), falling
// back to any owner/admin TenantMembership.

model ApprovalChain {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String   @db.ObjectId
  module         String   // "leave" | "resignation" | "wfh" | "salary_advance" | "overtime"
  name           String
  // Optional gate, e.g. { conditionField: "days", conditionOp: "gte", conditionValue: 5 }
  // for "leave > 5 days needs 2 approvers". Null condition = default/fallback chain
  // for the module.
  conditionField String?
  conditionOp    String?  // "gte" | "lte" | "eq" | "in"
  conditionValue Json?
  priority       Int      @default(0) // higher wins when multiple chains match
  isActive       Boolean  @default(true)
  createdBy      String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, module, isActive])
  @@map("approval_chains")
}

model ApprovalChainStep {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String  @db.ObjectId
  chainId        String  @db.ObjectId
  order          Int
  // How the actual approver is resolved when a request is instantiated:
  approverType   String  // "reporting_manager" | "specific_user" | "role" | "team_leader"
  approverUserId String? @db.ObjectId // when approverType = specific_user
  approverRole   String? // when approverType = role, e.g. "hr" | "admin" | "owner"

  @@index([chainId, order])
  @@map("approval_chain_steps")
}

// Runtime instance — one per approvable entity (LeaveApplication, Resignation, ...).
// Polymorphic by (module, entityId) rather than a hard relation, since the owning
// row may live in a different service's collection space.
model ApprovalInstance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  module      String
  entityId    String   @db.ObjectId
  requestedBy String   @db.ObjectId // original requester — used to resolve reporting-manager-type steps at any step order
  chainId     String?  @db.ObjectId // null = zero-config default chain was used
  status      String   @default("pending") // pending | approved | rejected | cancelled
  currentStep Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Not unique: an entity can accumulate more than one instance over its
  // lifetime (e.g. a leave's original apply-approval, then later a separate
  // instance for a cancellation-approval) — only one may be "pending" at a
  // time, enforced by application logic, not the DB.
  @@index([module, entityId, status])
  @@index([tenantId, module, status])
  @@map("approval_instances")
}

model ApprovalStepInstance {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String    @db.ObjectId
  instanceId         String    @db.ObjectId
  order              Int
  resolvedApproverId String    @db.ObjectId // after delegate resolution — who must act
  status             String    @default("pending") // pending | approved | rejected | skipped
  actedAt            DateTime?
  comment            String?

  @@index([instanceId, order])
  @@index([tenantId, resolvedApproverId, status])
  @@map("approval_step_instances")
}

// Date-ranged proxy approver, checked by the resolver before routing any step.
model ApprovalDelegate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  delegatorId String   @db.ObjectId // the out-of-office approver
  delegateId  String   @db.ObjectId // proxy
  startDate   DateTime
  endDate     DateTime
  module      String?  // null = applies to all modules
  note        String?
  createdAt   DateTime @default(now())

  @@index([tenantId, delegatorId, startDate, endDate])
  @@map("approval_delegates")
}

// ─── Org Structure ──────────────────────────────────────────────────────────
// Optional promotion of User.department/designation (free-text) into real
// entities with identity — a department head, a designation level/hierarchy.
// Tenants that never open Settings → Org Structure keep working purely off
// the free-text strings forever.

model Department {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @db.ObjectId
  name       String
  headUserId String?  @db.ObjectId
  isActive   Boolean  @default(true)
  createdBy  String?  @db.ObjectId
  createdAt  DateTime @default(now())

  @@unique([tenantId, name])
  @@map("departments")
}

model Designation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  name         String
  departmentId String?  @db.ObjectId
  level        Int?
  isActive     Boolean  @default(true)
  createdBy    String?  @db.ObjectId
  createdAt    DateTime @default(now())

  @@unique([tenantId, name])
  @@map("designations")
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String?  @db.ObjectId
  teamName     String
  teamLeaderId String   @db.ObjectId
  members      String[] @db.ObjectId
  // null = tenant default; same shape as TenantSettings.workWeekPattern.
  workWeekPatternOverride Json?

  @@index([tenantId])
  @@map("teams")
}

// ─── Tenant Settings ──────────────────────────────────────────────────────────
// Each row is an immutable versioned snapshot.
// The *active* settings at any moment = the latest row where effectiveFrom ≤ now.
// Future rows (effectiveFrom > now) are *pending* changes.

model TenantSettings {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String   @db.ObjectId
  // When this version becomes active. Defaults to now → immediate effect.
  effectiveFrom          DateTime @default(now())

  // ── Work week ──────────────────────────────────────────────────────────────
  // { type: "mon_fri" | "mon_sat" | "custom", workingDays: number[] } (0=Sun..6=Sat).
  // Asked once at signup (OrgSetupPage) because getting it wrong silently
  // corrupts attendance/leave day-count math — everything else in this model
  // is safe to auto-default and edit later.
  workWeekPattern        Json?

  // ── Leave ──────────────────────────────────────────────────────────────────
  paidLeavesPerYear      Int      @default(12)
  sickLeavesPerYear      Int      @default(12)
  casualLeavesPerYear    Int      @default(6)
  // Require a medical certificate when sickLeave=true
  medicalCertRequired    Boolean  @default(false)
  // Extra leave types: [{ name, key, daysPerYear, requiresProof }]
  customLeaveTypes       Json?
  // Richer per-leave-type policy, superseding the 3 scalar quota fields above
  // and customLeaveTypes when set: [{ key, name, daysPerYear, isStatutory,
  // requiresProof, accrualMethod, prorateByJoinDate, carryForward: {enabled,
  // maxDays, expiryMonths}, encashment: {enabled, ratePerDay, maxDaysPerYear},
  // isCompOff, compOffExpiryDays, onExhaustion, blackoutPeriods, teamConcurrentCapPercent }]
  // Left null, every tenant keeps today's behavior — simple quotas, no
  // carry-forward/encashment/blackout rules.
  leavePolicies          Json?

  // ── Attendance ─────────────────────────────────────────────────────────────
  // Work starts at workStartHour:workStartMinute (24-hour clock)
  workStartHour          Int      @default(9)
  workStartMinute        Int      @default(0)
  // Minutes after work-start before check-in is flagged as "Late"
  lateGracePeriodMinutes Int      @default(30)
  // Minimum working hours to count as a full day
  fullDayMinHours        Float    @default(8)
  // Minimum working hours to count as a half day (anything below → Half Day)
  halfDayMinHours        Float    @default(4)
  // How many days back an employee/admin may backdate a regularization request.
  regularizationBackdateWindowDays Int     @default(3)
  // When true, hours beyond the shift end only count as overtime once an
  // OvertimeRequest for that date has been approved.
  overtimePreApprovalRequired      Boolean @default(false)

  // ── Geofencing ─────────────────────────────────────────────────────────────
  // When true, CHECK_IN is blocked if employee is outside the allowed radius.
  geofencingEnabled      Boolean  @default(false)
  // Office GPS coordinates (set by admin via map picker)
  officeLatitude         Float?
  officeLongitude        Float?
  // Human-readable label shown to employees
  officeName             String?
  // Allowed radius in metres (applies to both office and WFH home location)
  geofenceRadiusMeters   Int      @default(200)

  // ── Modules ────────────────────────────────────────────────────────────────
  // Tenant-wide switch for the WFH module (distinct from User.wfh, which is
  // per-employee eligibility). Defaults true so existing tenants keep today's
  // behavior.
  wfhEnabled             Boolean  @default(true)

  // ── HR ─────────────────────────────────────────────────────────────────────
  probationPeriodDays    Int      @default(90)
  noticePeriodDays       Int      @default(30)
  // How many interview rounds this tenant normally runs per candidate.
  // scheduleInterview rejects going past it.
  maxInterviewRounds     Int      @default(5)

  // ── Audit ──────────────────────────────────────────────────────────────────
  createdBy              String?  @db.ObjectId
  note                   String?  // optional reason / changelog note

  createdAt              DateTime @default(now())

  @@unique([tenantId, effectiveFrom])
  @@map("tenant_settings")
}

// One row per tenant — org-level setup progress, not per-user. Any owner/admin
// completing or skipping a step marks it for the whole org, so a second admin
// logging in on another device doesn't see the whole checklist again.
model OnboardingChecklistState {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @db.ObjectId @unique
  itemStatus Json     @default("{}") // { stepKey: "completed" | "skipped" }
  updatedAt  DateTime @updatedAt

  @@map("onboarding_checklist_states")
}

// ─── Login Events ─────────────────────────────────────────────────────────────

model LoginEvent {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String?  @db.ObjectId
  userId            String   @db.ObjectId
  timestamp         DateTime @default(now())
  ip                String
  country           String?
  city              String?
  latitude          Float?
  longitude         Float?
  userAgent         String
  deviceFingerprint String
  // "GOOGLE_OAUTH" | "WEBAUTHN"
  loginMethod       String
  userEmail         String?
  riskScore         Int      @default(0)
  riskReasons       String[]
  isAnomaly         Boolean  @default(false)

  user              User     @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, timestamp])
  @@map("login_events")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────
// A PayrollRun represents one complete monthly payroll cycle.
// @@unique([tenantId, month, year]) prevents duplicate runs for the same period.

model PayrollRun {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String?   @db.ObjectId
  month           Int       // 1–12
  year            Int
  // draft → processing → approved → disbursing → disbursed | disbursement_failed | cancelled
  // "disbursing"/"disbursement_failed" exist because disbursement now runs
  // as a resumable background job (see payrollDisbursementWorker.ts) instead
  // of synchronously in the status-update request — see the identical note
  // on PayrollLineItem.postProcessed below for why resumability matters.
  status          String    @default("draft")
  initiatedBy     String    @db.ObjectId
  approvedBy      String?   @db.ObjectId
  disbursedBy     String?   @db.ObjectId
  totalGross      Float?
  totalNet        Float?
  totalDeductions Float?
  employeeCount   Int?
  notes           String?
  // Optional tag, not part of the uniqueness key below — a tenant running
  // multiple PayCycles still gets one run per (tenant, month, year) today;
  // full multi-cycle-per-month support needs a follow-up migration (see
  // PayCycle model comment) rather than changing this constraint inline.
  payCycleId      String?   @db.ObjectId
  employeeGroup   String?
  approvedAt      DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lineItems       PayrollLineItem[]

  @@unique([tenantId, month, year])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

// One row per employee per PayrollRun — immutable snapshot of earnings/deductions.
model PayrollLineItem {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String? @db.ObjectId
  payrollRunId     String  @db.ObjectId
  userId           String  @db.ObjectId
  grossSalary      Float
  basicPay         Float   @default(0)
  hra              Float   @default(0)
  conveyance       Float   @default(0)
  incentive        Float   @default(0)
  pf               Float   @default(0)
  esi              Float   @default(0)
  pt               Float   @default(0)
  advanceDeduction Float   @default(0) // SalaryAdvance EMI deducted this month
  tds              Float   @default(0) // Income tax (TDS) — see IncomeTaxSlab/TaxDeclaration
  otherDeductions  Float   @default(0)
  totalDeductions  Float   @default(0)
  netPayable       Float
  payslipId        String? @db.ObjectId // reference to SalaryStructure once generated
  // Same shape/fallback rule as SalaryStructure.componentBreakdown.
  componentBreakdown Json?

  // RazorpayX payout tracking — populated on disburse.
  payoutId            String?   // RazorpayX payout_id (e.g. "pout_xxx")
  payoutStatus        String?   // pending | processing | processed | skipped | failed | permanently_failed
  payoutFailureReason String?
  payoutInitiatedAt   DateTime?
  // Incremented on every failed payout attempt (see payrollDisbursement.ts).
  // Once it reaches MAX_PAYOUT_ATTEMPTS, payoutStatus moves from "failed" to
  // the distinct terminal "permanently_failed" instead of staying "failed"
  // forever — without this, a payout that will never succeed on its own
  // (bad bank details, a suspended RazorpayX account) got silently
  // re-attempted on every disbursement pass indefinitely.
  payoutAttempts      Int       @default(0)
  // Set once salary-advance reconciliation + payslip generation have run for
  // this item (see payrollDisbursement.ts). Disbursement runs as a resumable
  // background job — without this flag, retrying a crashed/partially-failed
  // job would double-decrement SalaryAdvance.remainingAmount for items
  // already reconciled in an earlier attempt (payslip regeneration itself is
  // safe — see SalaryStructure's @@unique — but the advance ledger isn't).
  postProcessed       Boolean   @default(false)

  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([tenantId, userId])
  @@map("payroll_line_items")
}

// Employee salary advance (loan) – repaid via monthly EMI deductions.
model SalaryAdvance {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String?   @db.ObjectId
  userId          String    @db.ObjectId
  amount          Float
  reason          String?
  // Pending | Approved | Rejected | Repaying | Repaid
  status          String    @default("Pending")
  approvedBy      String?   @db.ObjectId
  approvedAt      DateTime?
  emiAmount       Float?    // per-month deduction
  emiMonths       Int?      // total repayment months
  paidMonths      Int       @default(0)
  remainingAmount Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("salary_advances")
}

// ─── Performance Review ───────────────────────────────────────────────────────

model PerformanceReviewCycle {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String    @db.ObjectId
  name        String // "H1 2026 Annual Review"
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("draft") // draft | active | closed
  ratingScale Int       @default(5) // e.g. 1-5
  createdBy   String    @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reviews     PerformanceReview[]

  @@index([tenantId, status])
  @@map("performance_review_cycles")
}

model PerformanceReview {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  cycleId String @db.ObjectId
  userId  String @db.ObjectId // employee being reviewed
  // Reporting manager, resolved at creation from Team.teamLeaderId — left
  // unset when the employee isn't on any Team yet; the actual approval
  // routing at manager-review time is resolved independently by
  // @hrms/approval-engine (falls back to owner/admin), so this is
  // informational/denormalized rather than load-bearing.
  reviewerId String? @db.ObjectId
  // draft -> self_assessment_submitted -> manager_review_submitted -> approved | rejected
  status  String @default("draft")
  selfComments String?
  selfRating   Float?
  managerComments String?
  managerRating   Float?
  overallRating   Float?
  // HR's recommended comp change, proposed alongside the manager review
  recommendedIncrementPct Float?
  effectiveFrom           DateTime?
  // Populated once the final-approval side-effect (api-gateway) creates the
  // new SalaryStructure — cross-service reference, no Prisma @relation.
  salaryStructureId String?   @db.ObjectId
  submittedAt       DateTime?
  managerSubmittedAt DateTime?
  finalizedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cycle PerformanceReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  user  User?                  @relation(fields: [userId], references: [id])

  @@unique([cycleId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("performance_reviews")
}

// ─── Asset Management ─────────────────────────────────────────────────────────

// Tenant-scoped lookup of asset categories in use — mirrors Designation for
// job titles. The static starter set lives client-side (ASSET_CATEGORIES in
// AssetInventory.tsx); a category typed in at asset-creation time that isn't
// already known gets persisted here so it shows up in the dropdown next time.
model AssetCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  name      String
  isActive  Boolean  @default(true)
  createdBy String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@map("asset_categories")
}

model Asset {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String?   @db.ObjectId
  assetCode     String    // unique per tenant (e.g. "LAP-001")
  name          String
  // Free text, not a fixed enum — seeded with a starter set (Laptop, Desktop,
  // Phone, Tablet, Monitor, Furniture, Vehicle, Other) but HR can enter a new
  // one at creation time, same as Designation/jobTitle. See AssetCategory
  // below for the persisted, tenant-scoped lookup of categories in use.
  category      String
  brand         String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime?
  purchaseValue Float?
  // available | assigned | maintenance | retired
  status        String    @default("available")
  // good | fair | damaged
  condition     String    @default("good")
  notes         String?
  qrCodeUrl     String?   // S3 URL for generated QR image
  createdBy     String    @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments   AssetAssignment[]
  issues        AssetIssue[]

  @@unique([tenantId, assetCode])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("assets")
}

// Full audit trail: every assign and return is a new row.
model AssetAssignment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String?   @db.ObjectId
  assetId        String    @db.ObjectId
  userId         String    @db.ObjectId  // who holds the asset
  assignedBy     String    @db.ObjectId  // HR/admin who assigned
  assignedOn     DateTime  @default(now())
  expectedReturn DateTime?
  returnedOn     DateTime?
  returnedTo     String?   @db.ObjectId  // who received it back
  conditionOut      String    @default("good")
  conditionIn       String?   // recorded on return
  notes             String?
  // Employee signs off that they received the asset in the stated condition.
  acknowledgedAt    DateTime?
  acknowledgedNote  String?

  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([tenantId, userId])
  @@map("asset_assignments")
}

// Issue / defect report raised by an employee against an asset they hold.
model AssetIssue {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String?   @db.ObjectId
  assetId       String    @db.ObjectId
  assignmentId  String?   @db.ObjectId   // the active assignment when the issue was raised
  reportedBy    String    @db.ObjectId   // employee who reported
  // malfunction | damage | lost | stolen | return_request | other
  type          String
  // low | medium | high | critical
  priority      String    @default("medium")
  title         String
  description   String
  // open | in_review | approved | resolved | rejected
  status        String    @default("open")
  reviewedBy    String?   @db.ObjectId   // HR/admin who acted on it
  reviewedAt    DateTime?
  reviewNotes   String?   // HR's notes at review/decision time
  resolvedAt    DateTime?
  resolverNotes String?   // HR's notes at resolution time
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([tenantId, assetId])
  @@index([tenantId, reportedBy, status])
  @@index([tenantId, status])
  @@map("asset_issues")
}

// ─── WFH Requests ─────────────────────────────────────────────────────────────

model WfhRequest {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String?   @db.ObjectId
  userId          String    @db.ObjectId
  date            DateTime  // UTC midnight of the first requested day
  // UTC midnight of the last requested day — always set, equals `date` for a
  // single-day request. Kept non-optional (rather than null-for-single-day)
  // to sidestep Prisma's Mongo connector treating an explicit null and a
  // field that was never set as different query-match states.
  toDate          DateTime
  reason          String?
  // Pending | Approved | Rejected | Cancelled
  status          String    @default("Pending")
  approvedBy      String?   @db.ObjectId
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // No per-date uniqueness anymore — a request now spans [date, toDate], so
  // overlap with existing requests is checked in application code instead
  // (see requestWfh in apps/api-gateway/src/handlers/wfh.ts).
  @@index([tenantId, userId, status])
  @@index([tenantId, date, status])
  @@map("wfh_requests")
}

// ─── HR Helpdesk ──────────────────────────────────────────────────────────────

model Ticket {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?   @db.ObjectId
  ticketNo    String    // auto-generated sequential: TICK-00001
  title       String
  description String
  // IT | Payroll | Leave | Onboarding | HR | Other
  category    String
  // low | medium | high | critical
  priority    String    @default("medium")
  // open | in_progress | resolved | closed
  status      String    @default("open")
  raisedBy    String    @db.ObjectId
  assignedTo  String?   @db.ObjectId
  resolvedBy  String?   @db.ObjectId
  resolvedAt  DateTime?
  slaDeadline DateTime? // computed at creation from priority SLA hours
  slaBreached Boolean   @default(false)
  attachments String[]  // S3 URLs
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    TicketComment[]

  @@index([tenantId, raisedBy])
  @@index([tenantId, assignedTo, status])
  @@index([tenantId, status])
  @@index([tenantId, slaDeadline, slaBreached])
  @@map("tickets")
}

model TicketComment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String?   @db.ObjectId
  ticketId   String    @db.ObjectId
  userId     String    @db.ObjectId
  comment    String
  isInternal Boolean   @default(false) // internal note — hidden from the ticket raiser
  createdAt  DateTime  @default(now())

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

// ─── Tenant Webhooks ──────────────────────────────────────────────────────────

model WebhookEndpoint {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String    @db.ObjectId
  url       String
  // AES-256 encrypted signing secret; never returned in responses
  secret    String
  // e.g. ["leave.approved", "employee.created", "payroll.disbursed"]
  events    String[]
  isActive  Boolean   @default(true)
  createdBy String    @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

// Immutable delivery log — one row per delivery attempt batch.
model WebhookDelivery {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?   @db.ObjectId
  endpointId  String    @db.ObjectId
  eventType   String
  payload     Json
  // pending | success | failed
  status      String    @default("pending")
  httpStatus  Int?
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  responseBody String?
  error       String?
  createdAt   DateTime  @default(now())

  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@index([endpointId, status])
  @@index([tenantId, status])
  @@index([nextRetryAt])    // for retry sweeper job
  @@map("webhook_deliveries")
}

// ─── Custom Report Builder ────────────────────────────────────────────────────

model SavedReport {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?   @db.ObjectId
  name        String
  description String?
  // employee | attendance | leave | salary | recruitment | payroll
  entity      String
  // { filters: [...], columns: [...], groupBy?, sort?, limit? }
  config      Json
  schedule    String?   // cron expression for auto-delivery (null = on-demand only)
  recipients  String[]  // email addresses for scheduled delivery
  createdBy   String    @db.ObjectId
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, entity])
  @@index([tenantId, createdBy])
  @@map("saved_reports")
}

// ─── Dashboard preferences ───────────────────────────────────────────────────
// One row per person per organisation (tenant DB, so a person who belongs to
// two organisations keeps two layouts — their access differs per tenant).
// `widgets` is a list of { id, visible, size, settings }; it is always
// re-validated against the caller's current access when read
// (sanitizeLayout in api-gateway/src/config/dashboardWidgets.ts), so a stale
// row can hide or reorder widgets but never grant one.
model DashboardPreference {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  userId    String   @db.ObjectId
  version   Int      @default(1)
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@map("dashboard_preferences")
}

// ─── MCP (external AI assistants) ─────────────────────────────────────────────
// Both live in the master DB (see MASTER_MODELS in prismaWithTenant.ts): a
// client is registered before anyone signs in, and a grant has to be found
// from a bearer token before any tenant context exists.

// An OAuth client registered by an MCP client (Claude, ChatGPT, …) through
// dynamic client registration (RFC 7591). Public clients only: no secret is
// issued and PKCE (S256) is mandatory on every authorization.
model McpOAuthClient {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId     String   @unique
  clientName   String
  clientUri    String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@map("mcp_oauth_clients")
}

// One person's consent for one MCP client in one organisation. Access tokens
// carry the grant id and are refused once revokedAt is set, so revoking here
// cuts the client off on its very next call, not when its token expires.
model McpGrant {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @db.ObjectId
  tenantId             String    @db.ObjectId
  clientId             String
  // Denormalized from McpOAuthClient so the connected-apps list survives a
  // client record being cleaned up.
  clientName           String
  scopes               String[]
  // SHA-256 of the current refresh token, and of the one it replaced —
  // presenting the replaced one again means the token leaked, and the whole
  // grant is revoked (OAuth 2.1 refresh-token reuse detection).
  refreshTokenHash     String
  prevRefreshTokenHash String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?
  expiresAt            DateTime
  revokedAt            DateTime?
  revokedReason        String?

  @@index([userId, tenantId])
  @@index([refreshTokenHash])
  @@index([prevRefreshTokenHash])
  @@map("mcp_grants")
}
