            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter level = \"warn\" and @message like /(?i)${search:regex}/ | stats count(*) as warnings",
          "logGroupNames": ["$service"]
        }
      ],
      "options": {
        "reduceOptions": {
