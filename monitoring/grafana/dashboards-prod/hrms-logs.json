  "panels": [
    {
      "type": "stat",
      "title": "Errors",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter level = \"error\" and @message like /(?i)${search:regex}/ | stats count(*) as errors",
          "logGroupNames": ["$service"]
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
