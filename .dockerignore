# Git
.git
.gitignore

# Dependencies — reinstalled inside the container
node_modules
**/node_modules

# Build outputs — rebuilt inside the container
dist
**/dist
build
**/build
.turbo
**/.turbo
*.tsbuildinfo
**/*.tsbuildinfo

# Generated certs — never bake private keys into image layers
# They are mounted as a volume at runtime via docker-compose.dev.yml
packages/certificates/*.pem
packages/certificates/*.crt
packages/certificates/*.key

# Local monitoring data
.monitoring

# Logs
*.log
**/*.log

# OS artefacts
.DS_Store
Thumbs.db

# IDE
.vscode
.idea

# Test coverage
coverage
**/coverage

# Audit reports (artifacts/lighthouse); never part of an image
artifacts

# Not needed to compile any image (the Dockerfiles only need apps/,
# packages/, the root workspace/turbo/tsconfig files and docker/). Every
# pattern below is anchored at the repo root, so app-level folders with the
# same names (e.g. apps/api-gateway/docs/swagger, served by the gateway) are
# unaffected.
# Graphify analysis output, runs and baselines (~100 MB)
graphify-out
graphify-runs
graphify-baseline
# Root documentation, reviews and reports
docs
wiki
ARCHITECTURE_AUDIT.md
GRAPH_REPORT_*.md
GRAPHIFY_REMEDIATION_REPORT.md
PRODUCTION_READINESS_REVIEW.md
REMEDIATION_TEST_REPORT.md
FINAL_*.md
# Infrastructure, monitoring and load-test tooling (deployed separately)
cloudformation
monitoring
load-testing
# Local tool state
.claude
.playwright-mcp
