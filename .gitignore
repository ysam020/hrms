# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
apps/*/dist/
packages/*/dist/

# ── Turbo ────────────────────────────────────────────────────────────────────
.turbo/

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts
*.d.ts.map

# ── Generated files ──────────────────────────────────────────────────────────
packages/proto-definitions/src/generated/
packages/database/src/generated/

# ── Environment files ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
local-secrets.json

# ── Local secrets (never commit real values) ─────────────────────────────────
secrets.json
monitoring/secrets/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── SSL certificates ─────────────────────────────────────────────────────────
packages/certificates/*.pem
packages/certificates/*.crt
packages/certificates/*.key

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Vite / web ───────────────────────────────────────────────────────────────
apps/web/dist/
apps/web/dist-prerender/
apps/web/.vite/
stats.html

# ── Firebase ─────────────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log

# ── Docker ───────────────────────────────────────────────────────────────────
.dockerenv
docker/*.env

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Monitoring runtime data ───────────────────────────────────────────────────
.monitoring/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.local
.cache/

# ── iOS (Xcode project generated by xcodegen, see apps/ios/project.yml) ───────
apps/ios/*.xcodeproj/
apps/ios/DerivedData/
apps/ios/.build/
xcuserdata/
*.xcuserstate
