# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
apps/*/dist/
packages/*/dist/

# ── Turbo ────────────────────────────────────────────────────────────────────
.turbo/

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts
*.d.ts.map

# ── Generated files ──────────────────────────────────────────────────────────
packages/proto-definitions/src/generated/
packages/database/src/generated/

# ── Environment files ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── SSL certificates ─────────────────────────────────────────────────────────
# HTTPS gateway certs (generated locally, never committed)
packages/certificates/*.pem
packages/certificates/*.crt
packages/certificates/*.key
# gRPC internal certs — generated by scripts/gen-grpc-certs.sh
# The CA private key (ca.key) is deleted after cert signing, so only the
# public certs and service keys remain. These are safe to commit for a
# development/staging setup, but you may choose to ignore them too:
# packages/certificates/grpc/

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Vite / web ───────────────────────────────────────────────────────────────
apps/web/dist/
apps/web/.vite/
stats.html

# ── Firebase ─────────────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log

# ── Docker ───────────────────────────────────────────────────────────────────
.dockerenv

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Monitoring runtime data ───────────────────────────────────────────────────
.monitoring/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.local
.cache/
