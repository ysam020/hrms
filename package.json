{
  "name": "server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/generate-certs.mjs && cross-env LOKI_URL=http://localhost:3100 turbo run dev --concurrency=25",
    "build": "turbo run build",
    "test": "jest && pnpm --filter web test:run",
    "test:coverage": "jest --coverage --forceExit && pnpm --filter web test:coverage",
    "test:staged": "jest --onlyChanged && pnpm --filter web exec vitest run --changed",
    "start:prod": "turbo run start:prod",
    "lint": "eslint --no-config-lookup --config ./eslint.config.js \"**/*.{js,jsx,ts,tsx}\"",
    "proto:gen": "turbo run proto:gen",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "format": "prettier --write . && eslint --fix --no-config-lookup --config ./eslint.config.js \"**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "postinstall": "pnpm db:generate",
    "certs:generate": "node scripts/generate-certs.mjs",
    "setup:project": "pnpm certs:generate && pnpm proto:gen && pnpm db:generate && pnpm build",
    "ts:check": "npx tsc --project apps/web/tsconfig.json --noEmit 2>&1",
    "docker": "node scripts/docker.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@hrms/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "selfsigned": "^5.5.0",
    "ts-jest": "^29.4.9",
    "turbo": "^2.9.14",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-config-lookup --config ./eslint.config.js"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "@hrms/logger": "workspace:*",
    "@types/node": "^22.8.7",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "express": "^4.21.1",
    "winston": "^3.16.0",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.4.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.6": ">=7.5.6 <8.0.0",
      "protobufjs@>=8.0.0 <8.0.2": ">=8.0.2 <9.0.0",
      "@opentelemetry/core@<2.8.0": ">=2.9.0 <3.0.0",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8.0",
      "axios@<1.15.1": ">=1.15.1 <2.0.0",
      "tar-fs@>=2.0.0 <2.1.4": ">=2.1.4 <3.0.0",
      "form-data@<2.5.6": ">=2.5.6 <3.0.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5.0.0",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0 <8.0.0",
      "node-fetch@<2.6.7": ">=2.6.7 <3.0.0",
      "nth-check@<2.0.1": ">=2.0.1 <3.0.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3 <8.0.0",
      "fast-uri@<=3.1.0": ">=3.1.1 <4.0.0",
      "ws@>=7.0.0 <7.5.10": ">=7.5.10 <8.0.0",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1 <9.0.0",
      "fast-xml-builder@<=1.1.6": ">=1.1.7 <2.0.0",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4 <8.0.0",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "@grpc/grpc-js@<1.14.4": ">=1.14.4 <2.0.0",
      "linkify-it@<=5.0.0": ">=5.0.1 <6.0.0",
      "nodemailer@<9.0.3": ">=9.0.3 <10.0.0",
      "vite@>=8.0.0 <=8.0.4": ">=8.0.5 <9.0.0",
      "dompurify@<=3.3.3": ">=3.4.0 <4.0.0",
      "postcss@<8.5.10": ">=8.5.10 <9.0.0",
      "fast-xml-parser@<5.7.0": ">=5.7.0 <6.0.0",
      "ip-address@<10.3.1": ">=10.3.1 <11.0.0",
      "uuid@<11.1.1": ">=11.1.1 <12.0.0",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2 <7.0.0",
      "react-router@>=6.7.0 <6.30.4": ">=6.30.4 <7.0.0",
      "brace-expansion@>=1.0.0 <1.1.18": ">=1.1.18 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3.0.0",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9 <6.0.0",
      "ua-parser-js@>=2.0.1 <2.0.10": ">=2.0.10 <3.0.0",
      "js-yaml@<3.15.0": ">=3.15.0 <4.0.0",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0 <5.0.0",
      "tmp@<=0.2.3": ">=0.2.4 <0.3.0",
      "send@<0.19.0": ">=0.19.0 <0.20.0",
      "turbo@>=1.1.0 <2.9.14": ">=2.9.14 <3.0.0",
      "@tootallnate/once@<2.0.1": ">=2.0.1 <3.0.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0 <3.0.0",
      "engine.io@<6.6.7": ">=6.6.7 <7.0.0",
      "immutable@>=5.0.0 <5.1.8": ">=5.1.8 <6.0.0",
      "socket.io-parser@<4.2.7": ">=4.2.7 <5.0.0",
      "@smithy/types": "^4.14.0",
      "@smithy/smithy-client": "^4.12.9"
    }
  }
}
