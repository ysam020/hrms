{
  "name": "server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/generate-certs.mjs && cross-env LOKI_URL=http://localhost:3100 turbo run dev --concurrency=25",
    "build": "turbo run build",
    "test": "jest && pnpm --filter web test:run",
    "test:coverage": "jest --coverage --forceExit",
    "start:prod": "turbo run start:prod",
    "lint": "turbo run lint",
    "proto:gen": "turbo run proto:gen",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "format": "prettier --write . && eslint --fix --no-config-lookup --config ./eslint.config.js \"**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "postinstall": "pnpm db:generate",
    "certs:generate": "node scripts/generate-certs.mjs",
    "setup:project": "pnpm certs:generate && pnpm proto:gen && pnpm db:generate && pnpm build",
    "ts:check": "pnpm -r exec tsc -b",
    "docker:monitoring": "docker compose -f docker-compose.dev.yml up -d prometheus grafana loki",
    "docker:monitoring:down": "docker compose -f docker-compose.dev.yml stop prometheus grafana loki",
    "docker:push": "docker compose -f docker-compose.dev.yml push",
    "docker:build": "node scripts/generate-certs.mjs && cross-env COMPOSE_PARALLEL_LIMIT=4 docker compose -f docker-compose.dev.yml build",
    "docker:build:force": "node scripts/generate-certs.mjs && cross-env COMPOSE_PARALLEL_LIMIT=4 docker compose -f docker-compose.dev.yml build --no-cache",
    "docker:up": "node scripts/generate-certs.mjs && docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:start": "node scripts/generate-certs.mjs && cross-env COMPOSE_PARALLEL_LIMIT=4 docker compose -f docker-compose.dev.yml build && docker compose -f docker-compose.dev.yml up -d",
    "docker:infra": "docker compose -f docker-compose.dev.yml up -d mongodb redis",
    "docker:infra:down": "docker compose -f docker-compose.dev.yml stop mongodb redis",
    "docker:up:api-gateway": "docker compose -f docker-compose.dev.yml up -d api-gateway",
    "docker:up:auth": "docker compose -f docker-compose.dev.yml up -d auth-service",
    "docker:up:user": "docker compose -f docker-compose.dev.yml up -d user-service",
    "docker:up:employee": "docker compose -f docker-compose.dev.yml up -d employee-service",
    "docker:up:attendance": "docker compose -f docker-compose.dev.yml up -d attendance-service",
    "docker:up:leave": "docker compose -f docker-compose.dev.yml up -d leave-service",
    "docker:up:recruitment": "docker compose -f docker-compose.dev.yml up -d recruitment-service",
    "docker:up:hrm": "docker compose -f docker-compose.dev.yml up -d hrm-service",
    "docker:up:salary": "docker compose -f docker-compose.dev.yml up -d salary-service",
    "docker:up:analytics": "docker compose -f docker-compose.dev.yml up -d analytics-service",
    "docker:up:notification": "docker compose -f docker-compose.dev.yml up -d notification-service",
    "docker:up:scheduler": "docker compose -f docker-compose.dev.yml up -d scheduler-service",
    "docker:up:web": "docker compose -f docker-compose.dev.yml up -d web",
    "docker:rebuild:api-gateway": "docker compose -f docker-compose.dev.yml up -d --build api-gateway",
    "docker:rebuild:auth": "docker compose -f docker-compose.dev.yml up -d --build auth-service",
    "docker:rebuild:user": "docker compose -f docker-compose.dev.yml up -d --build user-service",
    "docker:rebuild:employee": "docker compose -f docker-compose.dev.yml up -d --build employee-service",
    "docker:rebuild:attendance": "docker compose -f docker-compose.dev.yml up -d --build attendance-service",
    "docker:rebuild:leave": "docker compose -f docker-compose.dev.yml up -d --build leave-service",
    "docker:rebuild:recruitment": "docker compose -f docker-compose.dev.yml up -d --build recruitment-service",
    "docker:rebuild:hrm": "docker compose -f docker-compose.dev.yml up -d --build hrm-service",
    "docker:rebuild:salary": "docker compose -f docker-compose.dev.yml up -d --build salary-service",
    "docker:rebuild:analytics": "docker compose -f docker-compose.dev.yml up -d --build analytics-service",
    "docker:rebuild:notification": "docker compose -f docker-compose.dev.yml up -d --build notification-service",
    "docker:rebuild:scheduler": "docker compose -f docker-compose.dev.yml up -d --build scheduler-service",
    "docker:rebuild:web": "docker compose -f docker-compose.dev.yml up -d --build web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@hrms/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "selfsigned": "^5.5.0",
    "ts-jest": "^29.4.9",
    "turbo": "^2.8.17",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-config-lookup --config ./eslint.config.js"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.3",
    "@grpc/proto-loader": "^0.7.13",
    "@hrms/logger": "workspace:*",
    "@types/node": "^22.8.7",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "express": "^4.21.1",
    "winston": "^3.16.0",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.4.0"
  }
}
