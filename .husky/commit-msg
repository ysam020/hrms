#!/bin/sh
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits and fixup/squash commits
case "$COMMIT_MSG" in
  Merge*|Revert*|fixup!*|squash!*)
    exit 0
    ;;
esac

# Conventional commits: type(optional-scope): description
# type: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "✖  ERROR: Commit message does not follow the Conventional Commits format."
  echo ""
  echo "   Expected: <type>(<optional scope>): <description>"
  echo "   Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo ""
  echo "   Examples:"
  echo "     feat(auth): add Google OAuth login"
  echo "     fix: resolve null pointer in user service"
  echo "     chore(deps): update axios to v1.7"
  echo ""
  echo "   Your message: $COMMIT_MSG"
  echo ""
  exit 1
fi
